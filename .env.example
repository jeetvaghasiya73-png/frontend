# Backend API URL (for local development: http://localhost:8000)
# In production (e.g. Vercel), set this to your hosted Oracle Cloud VM URL:
# NEXT_PUBLIC_API_URL=https://api.techinfinix.com
NEXT_PUBLIC_API_URL=https://api.techinfinix.com

# Secret Admin Panel Path (default: techinfinix-console-77)
# Public routes like /admin are cloaked with 404 Not Found
NEXT_PUBLIC_ADMIN_SLUG=techinfinix-console-77


